# ==============================================================================
# Global Accident Intelligence SaaS - Production Environment Configuration
# ==============================================================================
# Copy this file to .env.production on the host and customize values before deployment.
# NEVER commit production .env or secret keys to source control.
# ==============================================================================

# Application Metadata & Runtime Mode
PROJECT_NAME="Global Accident Intelligence SaaS"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"
WEB_CONCURRENCY=4

# ------------------------------------------------------------------------------
# Production Security & JWT Authentication
# ------------------------------------------------------------------------------
# CRITICAL: Generate a cryptographically secure key: `openssl rand -hex 32`
# In production, default development keys are rejected at startup.
SECRET_KEY="REPLACE_WITH_STRONG_CRYPTOGRAPHIC_SECRET_KEY_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
API_KEY_PREFIX_LIVE="agy_live_"
API_KEY_PREFIX_TEST="agy_test_"

# ------------------------------------------------------------------------------
# Production PostgreSQL Database
# ------------------------------------------------------------------------------
# In production, silent SQLite fallback is strictly prohibited.
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="accident_prod_user"
POSTGRES_PASSWORD="CHANGE_THIS_TO_SECURE_POSTGRES_PASSWORD"
POSTGRES_DB="accident_prod_db"
DATABASE_URL="postgresql+psycopg2://accident_prod_user:CHANGE_THIS_TO_SECURE_POSTGRES_PASSWORD@db:5432/accident_prod_db"

# Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Network, CORS & Trusted Hosts
# ------------------------------------------------------------------------------
# Comma-separated list of permitted origin domains.
# In production, avoid wildcard '*' to ensure browser credential support.
BACKEND_CORS_ORIGINS="https://app.accidentintel.com,https://api.accidentintel.com,http://localhost:3000"
ALLOWED_HOSTS="app.accidentintel.com,api.accidentintel.com,localhost"

# ------------------------------------------------------------------------------
# Rate Limiting & Licensing Enforcement
# ------------------------------------------------------------------------------
ENABLE_RATE_LIMITING=true
DEFAULT_RATE_LIMIT_PER_MINUTE=60
ENFORCE_MODEL_LICENSING=true

# ------------------------------------------------------------------------------
# Observability & Monitoring
# ------------------------------------------------------------------------------
# Optional Sentry DSN for production exception telemetry
# SENTRY_DSN="https://key@sentry.io/project-id"

# ------------------------------------------------------------------------------
# ML Model Artifacts & MLflow
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI="sqlite:///mlflow.db"
MLFLOW_ALLOW_FILE_STORE=true

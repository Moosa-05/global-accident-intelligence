# Local Production Deployment Rehearsal Configuration
PROJECT_NAME="Global Accident Intelligence SaaS"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="local_postgres_secure_pass_2026"
POSTGRES_DB="accident_db"
DATABASE_URL="postgresql+psycopg2://postgres:local_postgres_secure_pass_2026@db:5432/accident_db"

# JWT & Authentication (>= 32 chars)
SECRET_KEY="local-rehearsal-production-mode-secure-key-32chars!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
API_KEY_PREFIX_LIVE="agy_live_"
API_KEY_PREFIX_TEST="agy_test_"

# CORS & Trusted Hosts
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
ALLOWED_HOSTS="*"

# Workers & Enforcement
WEB_CONCURRENCY=4
ENABLE_RATE_LIMITING=true
ENFORCE_MODEL_LICENSING=true

# Ports for Host Mapping
API_PORT=8000
FRONTEND_PORT=3000

PROJECT_NAME="Accident Intelligence SaaS"
VERSION="2.1.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=accident_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/accident_db

# Security & Multi-Tenancy
SECRET_KEY=change-this-in-production-to-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ENABLE_RATE_LIMITING=true
ENFORCE_MODEL_LICENSING=true

# Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ALLOW_FILE_STORE=true
